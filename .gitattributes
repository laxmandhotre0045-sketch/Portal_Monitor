# Files that run on Linux (the VPS, Docker) must keep LF line endings, even when the
# repository is checked out on Windows. A CRLF deploy.sh fails with "$'\r': command not found".
*.sh              text eol=lf
Dockerfile        text eol=lf
docker-compose.yml text eol=lf
*.yml             text eol=lf
*.conf            text eol=lf
*.service         text eol=lf
*.sql             text eol=lf
.env.example      text eol=lf

# Windows-only scripts keep CRLF.
*.cmd             text eol=crlf
