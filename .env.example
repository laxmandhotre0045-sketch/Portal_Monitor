# Copy to /opt/portal-monitor/.env on the VPS and fill in. NEVER commit .env.
#   chmod 600 .env
# docker-compose.yml passes these to the container; docker/entrypoint.sh writes them to
# application.properties. deploy.sh reads only the DEPLOY_* / PM_PUBLIC_URL lines.

# --- MySQL (on the VPS itself: host.docker.internal) ---
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=portal_monitor_v2
DB_USERNAME=pm_app
DB_PASSWORD=CHANGE_ME
# The MySQL account must exist for the Docker address range, e.g.
#   'pm_app'@'172.16.0.0/255.240.0.0'   (see README "Database access from Docker")

# --- Email alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_FROM=CHANGE_ME@gmail.com
SMTP_FROM_NAME=Portal Monitor
ALERT_DEFAULT_EMAIL=CHANGE_ME@example.com

# --- Checks ---
CHECK_INTERVAL_SECONDS=60
CHECK_FAIL_THRESHOLD=3
CHECK_CONNECT_TIMEOUT_SECONDS=5
CHECK_REQUEST_TIMEOUT_SECONDS=10
CHECK_SUCCESS_CODES=200
CHECK_VERIFY_SSL=true

# --- API (agent reports). Long random value: openssl rand -hex 32 ---
SERVER_BIND=0.0.0.0
SERVER_PORT=8085
API_TOKEN=CHANGE_ME

AGENT_OFFLINE_AFTER_SECONDS=180
LOG_RETENTION_DAYS=30
APP_TIMEZONE=Asia/Kolkata
DB_PARAMS=allowPublicKeyRetrieval=true
JAVA_OPTS=-Xms32m -Xmx192m

# --- deploy.sh (optional) ---
# Public URL whose /health is checked through nginx after deploying.
PM_PUBLIC_URL=https://monitor.sensovibe.in
# DEPLOY_BRANCH=main
